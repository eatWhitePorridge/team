# Allowlisted build context: no .env, historical data, cookies, or token files.
**
!core/
!core/**/
!core/**/*.py
!config/
!config/**/
!config/**/*.py
!sentinel/
!sentinel/*.js
!webui/
!webui/__init__.py
!webui/team_admin_routes.py
!team-console/
!team-console/*.py
!team-console/requirements-docker.txt
!team-console/backend/
!team-console/backend/*.py
!team-console/tests/
!team-console/tests/*.py
!team-console/frontend/
!team-console/frontend/package.json
!team-console/frontend/package-lock.json
!team-console/frontend/tsconfig.json
!team-console/frontend/vite.config.ts
!team-console/frontend/index.html
!team-console/frontend/src/
!team-console/frontend/src/**
